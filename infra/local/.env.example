# Copia este archivo como infra/local/.env (ignorado por Git). Nunca subas el .env real.
# Las contraseñas de la base de datos NO van aquí: están en infra/local/secrets/ (fase 6.2.1).

POSTGRES_DB=cms
# Nombre del superusuario, que solo se usa para inicializar el volumen (opcional).
POSTGRES_SUPERUSER=cms_superuser

# Puertos en el equipo (siempre en 127.0.0.1).
CMS_DB_PORT=5432
CMS_API_PORT=8080

# Carpeta del equipo donde content-tool escribe la exportación. Debe estar FUERA del
# repositorio (dentro del contenedor no se puede comprobar). Relativa a infra/local/.
CMS_EXPORT_DIR=../../../blog-export

# Web pública en modo instantáneas (fase 6.3.5). Puerto en el equipo (siempre en 127.0.0.1).
CMS_WEB_PORT=4000
# Red interna de la publicación: subred fija e IP de la web (su puerto interno, 4100, solo escucha
# ahí). Cámbialas solo si chocan con otra red del equipo (una VPN, por ejemplo).
CMS_PUBLICACION_SUBNET=10.203.63.0/28
CMS_WEB_INTERNAL_IP=10.203.63.10
# Opcionales: URL pública del sitio y de la media (vacías en local; dominio real en la 6.9).
PUBLIC_SITE_URL=
MEDIA_BASE_URL=
